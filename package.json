    "framer-motion": "^12.43.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "simple-icons": "^13.21.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0",
